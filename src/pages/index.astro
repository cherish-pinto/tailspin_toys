---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = [...new Map(
  games.flatMap((game) => game.category ? [[game.category.id, game.category]] : []),
).values()].sort((a, b) => a.name.localeCompare(b.name));
const publishers = [...new Map(
  games.flatMap((game) => game.publisher ? [[game.publisher.id, game.publisher]] : []),
).values()].sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-6 mb-8 lg:flex-row lg:items-end lg:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>

        {games.length > 0 && (
          <div
            class="rounded-xl border border-slate-700 bg-slate-800/60 p-5 shadow-lg"
            data-testid="game-filters"
          >
            <div class="flex flex-col gap-5 sm:flex-row sm:items-end">
              <fieldset>
                <legend class="mb-2 text-sm font-semibold text-slate-200">Categories</legend>
                <div class="flex flex-wrap gap-3">
                  {categories.map((category) => (
                    <label class="flex items-center gap-2 text-sm text-slate-300">
                      <input
                        type="checkbox"
                        value={category.id}
                        data-category-filter={category.id}
                        data-testid={`category-filter-${category.id}`}
                        class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-800"
                      />
                      <span>{category.name}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <label class="flex flex-col gap-2 text-sm font-semibold text-slate-200">
                <span>Publisher</span>
                <select
                  data-publisher-filter
                  data-testid="publisher-filter"
                  class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 font-normal text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                  ))}
                </select>
              </label>

              <button
                type="button"
                data-reset-filters
                data-testid="reset-filters"
                class="rounded-lg border border-slate-600 px-3 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              >
                Clear filters
              </button>
            </div>
          </div>
        )}
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <p class="mb-4 text-sm text-slate-400" data-testid="filter-results" aria-live="polite">
            Showing {games.length} games
          </p>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="filter-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const categoryFilters = Array.from(document.querySelectorAll<HTMLInputElement>('[data-category-filter]'));
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-publisher-filter]');
  const resetButton = document.querySelector<HTMLButtonElement>('[data-reset-filters]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-results"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');

  const updateResults = (): void => {
    const selectedCategories = new Set(
      categoryFilters.filter((filter) => filter.checked).map((filter) => filter.value),
    );
    const selectedPublisher = publisherFilter?.value ?? '';
    let visibleCount = 0;

    cards.forEach((card) => {
      const categoryMatches =
        selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
      const publisherMatches =
        selectedPublisher === '' || selectedPublisher === card.dataset.publisherId;
      const isVisible = categoryMatches && publisherMatches;

      card.hidden = !isVisible;
      if (isVisible) {
        visibleCount += 1;
      }
    });

    if (resultCount) {
      resultCount.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
    }
    emptyState?.classList.toggle('hidden', visibleCount > 0);
  };

  categoryFilters.forEach((filter) => filter.addEventListener('change', updateResults));
  publisherFilter?.addEventListener('change', updateResults);
  resetButton?.addEventListener('click', () => {
    categoryFilters.forEach((filter) => {
      filter.checked = false;
    });
    if (publisherFilter) {
      publisherFilter.value = '';
    }
    updateResults();
  });
</script>
